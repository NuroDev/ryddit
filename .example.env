# Copy to `.env` (gitignored) for local dev, and set the real values in
# production with `wrangler secret put <NAME>`.
#
# Register an app at https://www.reddit.com/prefs/apps (type "web" or "script").
# The client id is shown under the app name; the secret is the "secret" field.
REDDIT_CLIENT_ID="your-client-id"
REDDIT_CLIENT_SECRET="your-client-secret"
