{
  "enabledPlugins": {
    "cloudflare@cloudflare": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm build*)",
      "Bash(pnpm cf-typegen*)",
      "Bash(pnpm check*)",
      "Bash(pnpm format*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm typecheck*)",
      "Bash(find *)",
      "Bash(grep *)",
      "Read(./**)",
      "WebFetch(domain:blog.cloudflare.com)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch"
    ],
    "deny": [
      "Bash(DROP TABLE*)",
      "Bash(find * -delete*)",
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(rm -fr)",
      "Bash(rm -rf)",
      "Bash(sudo*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "command": "bun run format 2>/dev/null || true",
            "statusMessage": "Formatting...",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
